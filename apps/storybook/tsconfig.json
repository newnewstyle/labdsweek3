{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Usage docs (<Name>.spec.ts, <Name>.md, SETUP.md) live next to each component in the
    // package source. Same alias as `resolve.alias` in .storybook/main.ts. Components themselves
    // are always imported from the built "@scope/ui".
    "paths": { "@ui-docs/*": ["../../packages/ui/src/*"] }
  },
  "include": ["src", ".storybook"]
}
